@using ExpenseTracker.Web.Controllers
@model SettingsViewModel
@{
    ViewData["Title"] = "Settings";
}

<div class="settings-hero mb-4 fade-in">
    <div class="d-flex align-items-center justify-content-between flex-wrap">
        <div class="d-flex align-items-center">
            <div class="me-3">
                <span class="hero-icon d-inline-flex align-items-center justify-content-center">
                    <i class="bi bi-gear-fill"></i>
                </span>
            </div>
            <div>
                <div class="hero-subtitle">Account Management</div>
                <h2 class="hero-title mb-0">Settings</h2>
            </div>
        </div>
    </div>
    <div class="hero-description mt-2">
        Customize your application preferences and account settings.
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post" asp-action="Settings" class="settings-form">
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="settings-card">
                <div class="settings-header">
                    <div class="settings-icon">
                        <i class="bi bi-bell-fill"></i>
                    </div>
                    <div class="settings-info">
                        <h5 class="settings-title">Notifications</h5>
                        <p class="settings-subtitle">Manage how you receive notifications</p>
                    </div>
                </div>
                
                <div class="settings-content">
                    <div class="setting-item">
                        <div class="setting-info">
                            <div class="setting-label">Email Notifications</div>
                            <div class="setting-description">Receive email alerts for important updates</div>
                        </div>
                        <div class="setting-control">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="EmailNotifications" id="emailNotifications">
                                <label class="form-check-label" for="emailNotifications"></label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-6">
            <div class="settings-card">
                <div class="settings-header">
                    <div class="settings-icon">
                        <i class="bi bi-palette-fill"></i>
                    </div>
                    <div class="settings-info">
                        <h5 class="settings-title">Appearance</h5>
                        <p class="settings-subtitle">Customize the look and feel</p>
                    </div>
                </div>
                
                <div class="settings-content">
                    <div class="setting-item">
                        <div class="setting-info">
                            <div class="setting-label">Dark Mode</div>
                            <div class="setting-description">Use dark theme for better night viewing</div>
                        </div>
                        <div class="setting-control">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="DarkMode" id="darkMode">
                                <label class="form-check-label" for="darkMode"></label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-6">
            <div class="settings-card">
                <div class="settings-header">
                    <div class="settings-icon">
                        <i class="bi bi-currency-rupee"></i>
                    </div>
                    <div class="settings-info">
                        <h5 class="settings-title">Regional</h5>
                        <p class="settings-subtitle">Currency and format preferences</p>
                    </div>
                </div>
                
                <div class="settings-content">
                    <div class="setting-item">
                        <div class="setting-info">
                            <div class="setting-label">Currency</div>
                            <div class="setting-description">Default currency for expenses</div>
                        </div>
                        <div class="setting-control">
                            <select class="form-select modern-select" asp-for="Currency">
                                <option value="INR" selected>INR - Indian Rupee</option>
                                <option value="USD">USD - US Dollar</option>
                                <option value="EUR">EUR - Euro</option>
                                <option value="GBP">GBP - British Pound</option>
                                <option value="CAD">CAD - Canadian Dollar</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="setting-item">
                        <div class="setting-info">
                            <div class="setting-label">Date Format</div>
                            <div class="setting-description">How dates are displayed</div>
                        </div>
                        <div class="setting-control">
                            <select class="form-select modern-select" asp-for="DateFormat">
                                <option value="MM/dd/yyyy">MM/dd/yyyy (US)</option>
                                <option value="dd/MM/yyyy">dd/MM/yyyy (UK)</option>
                                <option value="yyyy-MM-dd">yyyy-MM-dd (ISO)</option>
                                <option value="dd-MM-yyyy">dd-MM-yyyy</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-6">
            <div class="settings-card">
                <div class="settings-header">
                    <div class="settings-icon">
                        <i class="bi bi-globe"></i>
                    </div>
                    <div class="settings-info">
                        <h5 class="settings-title">Language</h5>
                        <p class="settings-subtitle">Application language preference</p>
                    </div>
                </div>
                
                <div class="settings-content">
                    <div class="setting-item">
                        <div class="setting-info">
                            <div class="setting-label">Display Language</div>
                            <div class="setting-description">Language for the interface</div>
                        </div>
                        <div class="setting-control">
                            <select class="form-select modern-select" asp-for="Language">
                                <option value="English">English</option>
                                <option value="Spanish">Español</option>
                                <option value="French">Français</option>
                                <option value="German">Deutsch</option>
                                <option value="Italian">Italiano</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="settings-actions mt-4">
        <div class="d-flex justify-content-end gap-3">
            <button type="button" class="btn btn-outline-secondary btn-modern">
                <i class="bi bi-arrow-clockwise me-1"></i>
                Reset to Defaults
            </button>
            <button type="submit" class="btn btn-primary btn-modern">
                <i class="bi bi-check2-circle me-1"></i>
                Save Settings
            </button>
        </div>
    </div>
</form>

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <style>
        .settings-hero {
            background: linear-gradient(135deg, rgba(13,110,253,.08), rgba(32,201,151,.06));
            border: 1px solid rgba(108,117,125,.12);
            border-radius: 1.25rem;
            padding: 2rem;
            backdrop-filter: blur(10px);
            position: relative;
            overflow: hidden;
        }

        .settings-card {
            background: var(--bs-body-bg);
            border: 1px solid rgba(108,117,125,.1);
            border-radius: 1.25rem;
            padding: 1.5rem;
            box-shadow: 0 4px 20px rgba(0,0,0,.06);
            height: 100%;
            transition: all 0.2s ease;
        }

        .settings-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0,0,0,.1);
        }

        .settings-header {
            display: flex;
            align-items: flex-start;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(108,117,125,.1);
        }

        .settings-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            margin-right: 1rem;
            flex-shrink: 0;
        }

        .settings-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--bs-emphasis-color);
            margin-bottom: 0.25rem;
        }

        .settings-subtitle {
            color: var(--bs-secondary-color);
            font-size: 0.875rem;
            margin: 0;
        }

        .settings-content {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .setting-item {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
        }

        .setting-info {
            flex: 1;
        }

        .setting-label {
            font-weight: 600;
            color: var(--bs-emphasis-color);
            margin-bottom: 0.25rem;
        }

        .setting-description {
            color: var(--bs-secondary-color);
            font-size: 0.875rem;
            line-height: 1.4;
        }

        .setting-control {
            flex-shrink: 0;
        }

        .modern-select {
            border-radius: 10px;
            border: 2px solid rgba(108,117,125,.15);
            padding: 0.5rem 0.75rem;
            transition: all 0.2s ease;
            background: var(--bs-body-bg);
            font-size: 0.875rem;
            min-width: 180px;
        }

        .modern-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.15);
            background: var(--bs-body-bg);
        }

        .form-check-input {
            width: 2.5rem;
            height: 1.25rem;
            border-radius: 0.625rem;
            background-color: rgba(108,117,125,.2);
            border: none;
            transition: all 0.3s ease;
        }

        .form-check-input:checked {
            background-color: #667eea;
            border-color: #667eea;
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

        .settings-actions {
            background: var(--bs-body-bg);
            border: 1px solid rgba(108,117,125,.1);
            border-radius: 1.25rem;
            padding: 1.5rem;
            box-shadow: 0 4px 20px rgba(0,0,0,.06);
        }

        /* Dark mode */
        [data-bs-theme="dark"] .settings-hero,
        [data-bs-theme="dark"] .settings-card,
        [data-bs-theme="dark"] .settings-actions {
            background-color: #1a1a1a;
            border-color: rgba(255,255,255,.08);
        }

        [data-bs-theme="dark"] .form-check-input {
            background-color: rgba(255,255,255,.2);
        }

        [data-bs-theme="dark"] .form-check-input:checked {
            background-color: #667eea;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .setting-item {
                flex-direction: column;
                align-items: stretch;
                gap: 0.75rem;
            }
            
            .modern-select {
                min-width: auto;
                width: 100%;
            }
            
            .settings-actions .d-flex {
                flex-direction: column;
            }
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Sync dark mode toggle with theme switch in header
        document.addEventListener('DOMContentLoaded', function() {
            const darkModeCheckbox = document.getElementById('darkMode');
            const themeToggle = document.getElementById('themeToggle');
            
            if (darkModeCheckbox && themeToggle) {
                // Set initial state
                darkModeCheckbox.checked = themeToggle.checked;
                
                // Sync changes
                darkModeCheckbox.addEventListener('change', function() {
                    themeToggle.checked = darkModeCheckbox.checked;
                    themeToggle.dispatchEvent(new Event('change'));
                });
                
                themeToggle.addEventListener('change', function() {
                    darkModeCheckbox.checked = themeToggle.checked;
                });
            }
        });
    </script>
}
