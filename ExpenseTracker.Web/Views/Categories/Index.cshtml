@model IEnumerable<ExpenseTracker.Web.Models.Category>
@{
    ViewData["Title"] = "Categories";
}
<div class="dashboard-hero mb-3">
    <div class="d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <span class="icon d-inline-flex align-items-center justify-content-center me-3" style="width:48px;height:48px;border-radius:12px;background:rgba(13,110,253,.12);color:#0d6efd;">
                <i class="bi bi-bookmarks"></i>
            </span>
            <div>
                <div class="fw-semibold text-uppercase small text-muted">Manage</div>
                <h4 class="mb-0">Categories</h4>
            </div>
        </div>
        <div>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#categoryModal" data-url="@Url.Action("Create","Categories")"><i class="bi bi-plus-lg me-1"></i>New Category</button>
        </div>
    </div>
</div>
<div id="categoriesList" data-list-url="@Url.Action("List","Categories")">
    @await Html.PartialAsync("_CategoryList", Model)
    </div>

@section Styles{
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/v/bs5/dt-2.1.5/datatables.min.css" />
}

@section Scripts{
    <script src="https://cdn.datatables.net/v/bs5/dt-2.1.5/datatables.min.js"></script>
    <script src="~/js/tables.js" asp-append-version="true"></script>
    <script src="~/js/categories.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function(){
            window.initializeCategoriesPage && window.initializeCategoriesPage();
        });
    </script>
}

<!-- Modal Host -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-body p-0 position-relative" id="categoryModalBody">
                <div class="p-5 text-center text-muted" id="categoryModalLoader" style="display:none;">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <div>Loading...</div>
                </div>
            </div>
        </div>
    </div>
</div>


