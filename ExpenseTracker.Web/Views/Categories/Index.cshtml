@model IEnumerable<ExpenseTracker.Web.Models.Category>
@{
    ViewData["Title"] = "Categories";
}
<div class="dashboard-hero mb-3">
    <div class="d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <span class="icon d-inline-flex align-items-center justify-content-center me-3" style="width:48px;height:48px;border-radius:12px;background:rgba(13,110,253,.12);color:#0d6efd;">
                <i class="bi bi-bookmarks"></i>
            </span>
            <div>
                <div class="fw-semibold text-uppercase small text-muted">Manage</div>
                <h4 class="mb-0">Categories</h4>
            </div>
        </div>
        <div>
            <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>New Category</a>
        </div>
    </div>
</div>
<div class="card card-neo">
    <div class="table-responsive">
        <table id="categoriesTable" class="table table-hover align-middle mb-0 table-modern">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>
                        @if (c.IsActive)
                        {
                            <span class="pill-uptrend">Active</span>
                        }
                        else
                        {
                            <span class="pill-downtrend">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.CategoryId">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@c.CategoryId">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Styles{
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/v/bs5/dt-2.1.5/datatables.min.css" />
}

@section Scripts{
    <script src="https://cdn.datatables.net/v/bs5/dt-2.1.5/datatables.min.js"></script>
    <script src="~/js/tables.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function(){
            if (window.initDataTable) {
                window.initDataTable('#categoriesTable', {
                    columnDefs: [
                        { targets: 2, orderable: false, searchable: false, className: 'text-end' }
                    ]
                });
            }
        });
    </script>
}


