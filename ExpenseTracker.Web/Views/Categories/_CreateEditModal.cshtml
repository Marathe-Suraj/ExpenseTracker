@model ExpenseTracker.Web.Models.Category
@{
    var isEdit = Model.CategoryId > 0;
    var formAction = isEdit ? "Edit" : "Create";
}

<div class="p-4">
    <h5 class="mb-3">@(isEdit ? "Edit Category" : "New Category")</h5>
    <form method="post" asp-action="@formAction" id="categoryForm">
        @if (isEdit)
        {
            <input type="hidden" asp-for="CategoryId" />
        }
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Name</label>
                <input class="form-control" asp-for="Name" />
                <span class="text-danger" asp-validation-for="Name"></span>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>@(isEdit?"Save":"Create")</button>
            <button type="button" class="btn btn-link" data-bs-dismiss="modal"><i class="bi bi-x-circle me-1"></i>Cancel</button>
        </div>
    </form>
    <partial name="_ValidationScriptsPartial" />
</div>


