@model ExpenseTracker.Web.Models.Category
@{
    var isEdit = Model.CategoryId > 0;
    var formAction = isEdit ? "Edit" : "Create";
}

<div class="category-modal">
    <div class="category-modal-header">
        <div class="modal-icon">
            <i class="bi bi-@(isEdit ? "pencil-square" : "plus-circle")"></i>
        </div>
        <div class="modal-title-section">
            <h4 class="modal-title">@(isEdit ? "Edit Category" : "Add New Category")</h4>
            <p class="modal-subtitle">@(isEdit ? "Update category information" : "Create a new expense category for better organization")</p>
        </div>
        <button type="button" class="btn-close-modern" data-bs-dismiss="modal" aria-label="Close">
            <i class="bi bi-x"></i>
        </button>
    </div>
    
    <div class="category-modal-body">
        <form method="post" asp-action="@formAction" id="categoryForm" class="category-form">
            @if (isEdit)
            {
                <input type="hidden" asp-for="CategoryId" />
            }
            
            <div class="form-group">
                <label class="form-label">
                    <i class="bi bi-tag me-2"></i>
                    Category Name
                </label>
                <input type="text" class="form-control modern-input" asp-for="Name" placeholder="Enter category name (e.g., Food, Transport, Entertainment)" />
                <span class="text-danger validation-message" asp-validation-for="Name"></span>
                <small class="form-text text-muted">Choose a descriptive name that helps you organize your expenses</small>
            </div>
            
            <div class="category-modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-modern" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary btn-modern">
                    <i class="bi bi-@(isEdit ? "check2-circle" : "plus-circle") me-1"></i>
                    @(isEdit ? "Update Category" : "Create Category")
                </button>
            </div>
        </form>
    </div>
    
    <partial name="_ValidationScriptsPartial" />
</div>

<style>
.category-modal {
    background: var(--bs-body-bg);
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,0.15);
    width: 100%;
    margin: 0;
}

.category-modal-header {
    display: flex;
    align-items: flex-start;
    padding: 2rem;
    border-bottom: 1px solid rgba(108,117,125,.1);
    background: rgba(108,117,125,.02);
}

.category-modal-body {
    padding: 2rem;
}

.form-group {
    margin-bottom: 0;
}

.form-label {
    font-weight: 600;
    color: var(--bs-emphasis-color);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    font-size: 0.9rem;
}

.form-label i {
    color: var(--bs-secondary-color);
    opacity: 0.7;
}

.modern-input {
    border-radius: 10px;
    border: 2px solid rgba(108,117,125,.15);
    padding: 0.75rem 1rem;
    transition: all 0.2s ease;
    background: var(--bs-body-bg);
    font-size: 0.95rem;
}

.modern-input:focus {
    border-color: #667eea;
    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.15);
    background: var(--bs-body-bg);
}

.validation-message {
    font-size: 0.8rem;
    margin-top: 0.25rem;
    display: block;
}

.category-modal-footer {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(108,117,125,.1);
    margin-top: 1.5rem;
}

/* Dark mode */
[data-bs-theme="dark"] .category-modal {
    background-color: #1a1a1a;
}

[data-bs-theme="dark"] .category-modal-header {
    background: rgba(255,255,255,.02);
    border-color: rgba(255,255,255,.08);
}

[data-bs-theme="dark"] .category-modal-footer {
    border-color: rgba(255,255,255,.08);
}

/* Responsive */
@@media (max-width: 576px) {
    .category-modal-header,
    .category-modal-body {
        padding: 1.5rem;
    }
    
    .category-modal-footer {
        flex-direction: column;
    }
}
</style>


