@model ExpenseTracker.Web.Models.Category

<div class="p-4">
    <h5 class="mb-3 text-danger">Delete Category</h5>
    <p>Are you sure you want to delete this category?</p>
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Active</dt>
        <dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>
    </dl>
    <form method="post" asp-action="Delete" asp-route-id="@Model.CategoryId" id="categoryDeleteForm">
        <input type="hidden" asp-for="CategoryId" />
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            <button type="button" class="btn btn-link" data-bs-dismiss="modal"><i class="bi bi-x-circle me-1"></i>Cancel</button>
        </div>
    </form>
</div>


