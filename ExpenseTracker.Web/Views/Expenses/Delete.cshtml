@model ExpenseTracker.Web.Models.Expense
@{
    ViewData["Title"] = "Delete Expense";
}
<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3 class="mb-3">Delete Expense</h3>
                <p>Are you sure you want to delete this expense?</p>
                <dl class="row">
                    <dt class="col-sm-3">Date</dt>
                    <dd class="col-sm-9">@Model.ExpenseDate.ToString("yyyy-MM-dd")</dd>
                    <dt class="col-sm-3">Amount</dt>
                    <dd class="col-sm-9">@Model.Amount.ToString("C2")</dd>
                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@Model.Description</dd>
                </dl>
                <form method="post">
                    <input type="hidden" asp-for="ExpenseId" />
                    <button class="btn btn-danger">Delete</button>
                    <a class="btn btn-link" asp-action="Index">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>


