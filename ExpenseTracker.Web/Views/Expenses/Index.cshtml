@model IEnumerable<ExpenseTracker.Web.Models.Expense>
@using ExpenseTracker.Web.ViewModels
@{
    ViewData["Title"] = "Expenses";
    var paged = (PagedResult<ExpenseTracker.Web.Models.Expense>)ViewBag.Paged;
    var filter = (ExpenseFilterViewModel)ViewBag.Filter;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Expenses</h3>
    <div>
        <a class="btn btn-outline-secondary me-2" asp-action="ExportExcel" asp-route-search="@filter.Search" asp-route-categoryId="@filter.CategoryId" asp-route-fromDate="@filter.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@filter.ToDate?.ToString("yyyy-MM-dd")">Excel</a>
        <a class="btn btn-outline-secondary me-2" asp-action="ExportPdf" asp-route-search="@filter.Search" asp-route-categoryId="@filter.CategoryId" asp-route-fromDate="@filter.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@filter.ToDate?.ToString("yyyy-MM-dd")">PDF</a>
        <a class="btn btn-primary" asp-action="Create">New Expense</a>
    </div>
</div>

<form method="get" class="card shadow-sm mb-3 p-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input class="form-control" name="search" value="@filter.Search" placeholder="Description contains..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Category</label>
            <select class="form-select" name="CategoryId" asp-items="filter.Categories">
                <option value="">All</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">From</label>
            <div class="input-group">
                <input id="fromDate" type="date" class="form-control" name="FromDate" value="@filter.FromDate?.ToString("yyyy-MM-dd")" />
                <button type="button" class="btn btn-outline-secondary" title="Clear" data-clear-target="#fromDate">&times;</button>
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label">To</label>
            <div class="input-group">
                <input id="toDate" type="date" class="form-control" name="ToDate" value="@filter.ToDate?.ToString("yyyy-MM-dd")" />
                <button type="button" class="btn btn-outline-secondary" title="Clear" data-clear-target="#toDate">&times;</button>
            </div>
        </div>
        <div class="col-md-1">
            <button class="btn btn-secondary w-100">Go</button>
        </div>
    </div>
</form>

<div class="d-none d-md-block">
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Category</th>
                        <th class="text-end">Amount</th>
                        <th>Description</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.ExpenseDate.ToString("dd-MM-yyyy")</td>
                            <td>@(((IDictionary<int, string>)ViewBag.CatLookup)[e.CategoryId])</td>
                            <td class="text-end">@e.Amount.ToString("C2")</td>
                            <td>@e.Description</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.ExpenseId">Edit</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@e.ExpenseId">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-md-none">
    <div class="row g-3">
        @foreach (var e in Model)
        {
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="fw-semibold">@e.Description</div>
                                <div class="text-muted small">@e.ExpenseDate.ToString("dd-MM-yyyy") • @(((IDictionary<int, string>)ViewBag.CatLookup)[e.CategoryId])</div>
                            </div>
                            <div class="fw-bold">@e.Amount.ToString("C2")</div>
                        </div>
                        <div class="mt-2 text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.ExpenseId">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@e.ExpenseId">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    </div>

<nav aria-label="Page navigation" class="mt-3">
    <ul class="pagination">
        @for (int p = 1; p <= paged.TotalPages; p++)
        {
            <li class="page-item @(p == paged.Page ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-pageSize="@paged.PageSize" asp-route-search="@filter.Search" asp-route-categoryId="@filter.CategoryId" asp-route-fromDate="@filter.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@filter.ToDate?.ToString("yyyy-MM-dd")">@p</a>
            </li>
        }
    </ul>
</nav>


@section Scripts{
    <link rel="stylesheet" href="~/css/expenses.css" asp-append-version="true" />
    <script src="~/js/expenses.js" asp-append-version="true"></script>
}
