@model IEnumerable<ExpenseTracker.Web.Models.Expense>
@using ExpenseTracker.Web.ViewModels
@{
    ViewData["Title"] = "Expenses";
    var paged = (PagedResult<ExpenseTracker.Web.Models.Expense>)ViewBag.Paged;
    var filter = (ExpenseFilterViewModel)ViewBag.Filter;
}

<div class="dashboard-hero mb-3">
    <div class="d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <span class="icon d-inline-flex align-items-center justify-content-center me-3" style="width:48px;height:48px;border-radius:12px;background:rgba(13,110,253,.12);color:#0d6efd;">
                <i class="bi bi-receipt"></i>
            </span>
    <div>
                <div class="fw-semibold text-uppercase small text-muted">Manage</div>
                <h4 class="mb-0">Expenses</h4>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <a class="btn btn-outline-secondary me-2 d-none d-sm-inline-flex" asp-action="ExportExcel" asp-route-search="@filter.Search" asp-route-categoryId="@filter.CategoryId" asp-route-fromDate="@filter.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@filter.ToDate?.ToString("yyyy-MM-dd")"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
            <a class="btn btn-outline-secondary me-2 d-none d-sm-inline-flex" asp-action="ExportPdf" asp-route-search="@filter.Search" asp-route-categoryId="@filter.CategoryId" asp-route-fromDate="@filter.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@filter.ToDate?.ToString("yyyy-MM-dd")"><i class="bi bi-filetype-pdf me-1"></i>PDF</a>
            <button type="button" class="btn btn-outline-secondary me-2 d-sm-none" data-bs-toggle="modal" data-bs-target="#exportModal"><i class="bi bi-box-arrow-up"></i></button>
            <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>New Expense</a>
        </div>
    </div>
    <div class="small text-muted mt-2">Filter, export and manage all your expenses.</div>
</div>

<form method="get" class="card card-neo mb-3 p-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Category</label>
            <select class="form-select" name="CategoryId" asp-items="filter.Categories">
                <option value="">All</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">From</label>
            <div class="input-group">
                <input id="fromDate" type="date" class="form-control" name="FromDate" value="@filter.FromDate?.ToString("yyyy-MM-dd")" />
                <button type="button" class="btn btn-outline-secondary" title="Clear" data-clear-target="#fromDate">&times;</button>
            </div>
        </div>
        <div class="col-md-3">
            <label class="form-label">To</label>
            <div class="input-group">
                <input id="toDate" type="date" class="form-control" name="ToDate" value="@filter.ToDate?.ToString("yyyy-MM-dd")" />
                <button type="button" class="btn btn-outline-secondary" title="Clear" data-clear-target="#toDate">&times;</button>
            </div>
        </div>
        <div class="col-md-2">
            <button class="btn btn-secondary w-100">Go</button>
        </div>
    </div>
</form>

<div class="d-none d-md-block">
    <div class="card card-neo">
        <div class="table-responsive">
            <table id="expensesTable" class="table table-hover align-middle mb-0 table-modern">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Category</th>
                        <th class="text-end">Amount</th>
                        <th>Description</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.ExpenseDate.ToString("dd-MM-yyyy")</td>
                            <td>@(((IDictionary<int, string>)ViewBag.CatLookup)[e.CategoryId])</td>
                            <td class="text-end">@e.Amount.ToString("C2")</td>
                            <td>@e.Description</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.ExpenseId">Edit</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@e.ExpenseId">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-md-none">
    <div class="row g-3">
        @foreach (var e in Model)
        {
            <div class="col-12">
                <div class="card card-neo">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="fw-semibold"><i class="bi bi-receipt-cutoff me-1"></i>@e.Description</div>
                                <div class="text-muted small"><i class="bi bi-calendar3 me-1"></i>@e.ExpenseDate.ToString("dd-MM-yyyy") • <i class="bi bi-bookmark me-1"></i>@(((IDictionary<int, string>)ViewBag.CatLookup)[e.CategoryId])</div>
                            </div>
                            <div class="fw-bold">@e.Amount.ToString("C2")</div>
                        </div>
                        <div class="mt-2 text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.ExpenseId">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@e.ExpenseId">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    </div>

<nav id="serverPagination" aria-label="Page navigation" class="mt-3">
    <ul class="pagination">
        @for (int p = 1; p <= paged.TotalPages; p++)
        {
            <li class="page-item @(p == paged.Page ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-pageSize="@paged.PageSize" asp-route-search="@filter.Search" asp-route-categoryId="@filter.CategoryId" asp-route-fromDate="@filter.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@filter.ToDate?.ToString("yyyy-MM-dd")">@p</a>
            </li>
        }
    </ul>
</nav>


<!-- Export Modal (mobile friendly) -->
<div class="modal fade" id="exportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Export Expenses</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-grid gap-2">
                <a class="btn btn-outline-secondary" asp-action="ExportExcel" asp-route-search="@filter.Search" asp-route-categoryId="@filter.CategoryId" asp-route-fromDate="@filter.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@filter.ToDate?.ToString("yyyy-MM-dd")"><i class="bi bi-file-earmark-excel me-1"></i> Excel</a>
                <a class="btn btn-outline-secondary" asp-action="ExportPdf" asp-route-search="@filter.Search" asp-route-categoryId="@filter.CategoryId" asp-route-fromDate="@filter.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@filter.ToDate?.ToString("yyyy-MM-dd")"><i class="bi bi-filetype-pdf me-1"></i> PDF</a>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Styles{
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/expenses.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/v/bs5/dt-2.1.5/datatables.min.css" />
}

@section Scripts{
    <script src="https://cdn.datatables.net/v/bs5/dt-2.1.5/datatables.min.js"></script>
    <script src="~/js/expenses.js" asp-append-version="true"></script>
    <script src="~/js/tables.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function(){
            if (window.initDataTable) {
                window.initDataTable('#expensesTable', {
                    columnDefs: [
                        { targets: 2, className: 'text-end' },
                        { targets: 4, orderable: false, searchable: false, className: 'text-end' }
                    ]
                });
            }
        });
    </script>
}
