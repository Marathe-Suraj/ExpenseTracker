@model ExpenseTracker.Web.Models.Expense
@{
    var isEdit = Model.ExpenseId > 0;
    var formAction = isEdit ? "Edit" : "Create";
}

<div class="expense-modal">
    <div class="expense-modal-header">
        <div class="modal-icon">
            <i class="bi bi-@(isEdit ? "pencil-square" : "plus-circle")"></i>
        </div>
        <div class="modal-title-section">
            <h4 class="modal-title">@(isEdit ? "Edit Expense" : "Add New Expense")</h4>
            <p class="modal-subtitle">@(isEdit ? "Update your expense details" : "Track your spending with detailed information")</p>
        </div>
        <button type="button" class="btn-close-modern" data-bs-dismiss="modal" aria-label="Close">
            <i class="bi bi-x"></i>
        </button>
    </div>
    
    <div class="expense-modal-body">
        <form method="post" asp-action="@formAction" id="expenseForm" class="expense-form">
            @if (isEdit)
            {
                <input type="hidden" asp-for="ExpenseId" />
            }
            
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">
                        <i class="bi bi-calendar-event me-2"></i>
                        Expense Date
                    </label>
                    <input type="date" class="form-control modern-input" asp-for="ExpenseDate" />
                    <span class="text-danger validation-message" asp-validation-for="ExpenseDate"></span>
                </div>
                
                <div class="form-group">
                    <label class="form-label">
                        <i class="bi bi-tag me-2"></i>
                        Category
                    </label>
                    <select class="form-select modern-select" asp-for="CategoryId" asp-items="ViewBag.Categories">
                        <option value="">Select a category</option>
                    </select>
                    <span class="text-danger validation-message" asp-validation-for="CategoryId"></span>
                </div>
                
                <div class="form-group">
                    <label class="form-label">
                        <i class="bi bi-currency-rupee me-2"></i>
                        Amount
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">₹</span>
                        <input type="number" step="0.01" min="0" class="form-control modern-input" asp-for="Amount" placeholder="0.00" />
                    </div>
                    <span class="text-danger validation-message" asp-validation-for="Amount"></span>
                </div>
                
                <div class="form-group form-group-full">
                    <label class="form-label">
                        <i class="bi bi-card-text me-2"></i>
                        Description
                    </label>
                    <textarea class="form-control modern-input" asp-for="Description" rows="3" placeholder="What did you spend on?"></textarea>
                    <span class="text-danger validation-message" asp-validation-for="Description"></span>
                </div>
            </div>
            
            <div class="expense-modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-modern" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary btn-modern">
                    <i class="bi bi-@(isEdit ? "check2-circle" : "plus-circle") me-1"></i>
                    @(isEdit ? "Update Expense" : "Add Expense")
                </button>
            </div>
        </form>
    </div>
    
    <partial name="_ValidationScriptsPartial" />
</div>

<style>
.expense-modal {
    background: var(--bs-body-bg);
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,0.15);
    width: 100%;
    margin: 0;
}

.expense-modal-header {
    display: flex;
    align-items: flex-start;
    padding: 2rem;
    border-bottom: 1px solid rgba(108,117,125,.1);
    background: rgba(108,117,125,.02);
}

.modal-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    margin-right: 1rem;
    flex-shrink: 0;
}

.modal-title-section {
    flex: 1;
}

.modal-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--bs-emphasis-color);
    margin-bottom: 0.25rem;
}

.modal-subtitle {
    color: var(--bs-secondary-color);
    font-size: 0.9rem;
    margin: 0;
}

.btn-close-modern {
    background: none;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bs-secondary-color);
    transition: all 0.2s ease;
}

.btn-close-modern:hover {
    background: rgba(108,117,125,.1);
    color: var(--bs-emphasis-color);
}

.expense-modal-body {
    padding: 2rem;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.form-group-full {
    grid-column: 1 / -1;
}

.form-label {
    font-weight: 600;
    color: var(--bs-emphasis-color);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    font-size: 0.9rem;
}

.form-label i {
    color: var(--bs-secondary-color);
    opacity: 0.7;
}

.modern-input,
.modern-select {
    border-radius: 10px;
    border: 2px solid rgba(108,117,125,.15);
    padding: 0.75rem 1rem;
    transition: all 0.2s ease;
    background: var(--bs-body-bg);
    font-size: 0.95rem;
}

.modern-input:focus,
.modern-select:focus {
    border-color: #667eea;
    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.15);
    background: var(--bs-body-bg);
}

.input-group-text {
    border-radius: 10px 0 0 10px;
    border: 2px solid rgba(108,117,125,.15);
    border-right: none;
    background: rgba(108,117,125,.05);
    color: var(--bs-secondary-color);
    font-weight: 600;
}

.input-group .modern-input {
    border-radius: 0 10px 10px 0;
    border-left: none;
}

.validation-message {
    font-size: 0.8rem;
    margin-top: 0.25rem;
    display: block;
}

.expense-modal-footer {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(108,117,125,.1);
}

/* Dark mode */
[data-bs-theme="dark"] .expense-modal {
    background-color: #1a1a1a;
}

[data-bs-theme="dark"] .expense-modal-header {
    background: rgba(255,255,255,.02);
    border-color: rgba(255,255,255,.08);
}

[data-bs-theme="dark"] .expense-modal-footer {
    border-color: rgba(255,255,255,.08);
}

[data-bs-theme="dark"] .input-group-text {
    background: rgba(255,255,255,.05);
    border-color: rgba(255,255,255,.15);
}

/* Responsive */
@@media (max-width: 576px) {
    .form-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
    
    .expense-modal-header,
    .expense-modal-body {
        padding: 1.5rem;
    }
    
    .expense-modal-footer {
        flex-direction: column;
    }
}
</style>


