@model ExpenseTracker.Web.Models.Expense

<div class="delete-modal">
    <div class="delete-modal-header">
        <div class="modal-icon danger-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <div class="modal-title-section">
            <h4 class="modal-title">Delete Expense</h4>
            <p class="modal-subtitle">This action cannot be undone</p>
        </div>
        <button type="button" class="btn-close-modern" data-bs-dismiss="modal" aria-label="Close">
            <i class="bi bi-x"></i>
        </button>
    </div>
    
    <div class="delete-modal-body">
        <div class="warning-message">
            <i class="bi bi-info-circle me-2"></i>
            Are you sure you want to delete this expense? This action cannot be undone.
        </div>
        
        <div class="expense-details">
            <div class="detail-item">
                <div class="detail-label">
                    <i class="bi bi-calendar-event me-2"></i>Date
                </div>
                <div class="detail-value">@Model.ExpenseDate.ToString("MMM dd, yyyy")</div>
            </div>
            
            <div class="detail-item">
                <div class="detail-label">
                    <i class="bi bi-currency-rupee me-2"></i>Amount
                </div>
                <div class="detail-value amount-highlight">@Model.Amount.ToString("C2")</div>
            </div>
            
            <div class="detail-item">
                <div class="detail-label">
                    <i class="bi bi-card-text me-2"></i>Description
                </div>
                <div class="detail-value">@(string.IsNullOrEmpty(Model.Description) ? "No description" : Model.Description)</div>
            </div>
        </div>
        
        <form method="post" asp-action="Delete" asp-route-id="@Model.ExpenseId" id="expenseDeleteForm">
            <input type="hidden" asp-for="ExpenseId" />
            <div class="delete-modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-modern" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>
                    Cancel
                </button>
                <button type="submit" class="btn btn-danger btn-modern">
                    <i class="bi bi-trash me-1"></i>
                    Delete Expense
                </button>
            </div>
        </form>
    </div>
</div>

<style>
.delete-modal {
    background: var(--bs-body-bg);
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,0.15);
    width: 100%;
    margin: 0;
}

.delete-modal-header {
    display: flex;
    align-items: flex-start;
    padding: 2rem;
    border-bottom: 1px solid rgba(108,117,125,.1);
    background: rgba(220, 53, 69, 0.05);
}

.danger-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    margin-right: 1rem;
    flex-shrink: 0;
}

.delete-modal-body {
    padding: 2rem;
}

.warning-message {
    background: rgba(255, 193, 7, 0.1);
    border: 1px solid rgba(255, 193, 7, 0.3);
    border-radius: 10px;
    padding: 1rem;
    margin-bottom: 1.5rem;
    color: #856404;
    display: flex;
    align-items: center;
}

.expense-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
}

.detail-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem;
    background: rgba(108,117,125,.03);
    border-radius: 8px;
}

.detail-label {
    font-weight: 600;
    color: var(--bs-secondary-color);
    display: flex;
    align-items: center;
}

.detail-value {
    font-weight: 500;
    color: var(--bs-emphasis-color);
}

.amount-highlight {
    font-size: 1.1rem;
    font-weight: 700;
    color: #dc3545;
}

.delete-modal-footer {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(108,117,125,.1);
}

/* Dark mode */
[data-bs-theme="dark"] .delete-modal {
    background-color: #1a1a1a;
}

[data-bs-theme="dark"] .delete-modal-header {
    background: rgba(220, 53, 69, 0.1);
    border-color: rgba(255,255,255,.08);
}

[data-bs-theme="dark"] .delete-modal-footer {
    border-color: rgba(255,255,255,.08);
}

[data-bs-theme="dark"] .warning-message {
    background: rgba(255, 193, 7, 0.15);
    color: #ffc107;
}

[data-bs-theme="dark"] .detail-item {
    background: rgba(255,255,255,.04);
}

/* Responsive */
@@media (max-width: 576px) {
    .delete-modal-header,
    .delete-modal-body {
        padding: 1.5rem;
    }
    
    .delete-modal-footer {
        flex-direction: column;
    }
    
    .detail-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
    }
}
</style>


