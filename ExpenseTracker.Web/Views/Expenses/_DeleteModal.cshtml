@model ExpenseTracker.Web.Models.Expense

<div class="p-4">
    <h5 class="mb-3 text-danger">Delete Expense</h5>
    <p>Are you sure you want to delete this expense?</p>
    <dl class="row">
        <dt class="col-sm-3">Date</dt>
        <dd class="col-sm-9">@Model.ExpenseDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">Amount</dt>
        <dd class="col-sm-9">@Model.Amount.ToString("C2")</dd>
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>
    </dl>
    <form method="post" asp-action="Delete" asp-route-id="@Model.ExpenseId" id="expenseDeleteForm">
        <input type="hidden" asp-for="ExpenseId" />
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            <button type="button" class="btn btn-link" data-bs-dismiss="modal"><i class="bi bi-x-circle me-1"></i>Cancel</button>
        </div>
    </form>
</div>


