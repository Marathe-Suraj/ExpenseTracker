@model IEnumerable<ExpenseTracker.Web.Models.Expense>
@using ExpenseTracker.Web.ViewModels
@{
    var paged = (PagedResult<ExpenseTracker.Web.Models.Expense>)ViewBag.Paged;
    var filter = (ExpenseFilterViewModel)ViewBag.Filter;
}

<!-- Desktop View with Toggle -->
<div class="d-none d-lg-block">
    <div class="expenses-table-card">
        <div class="table-header">
            <div class="table-info">
                <h6 class="table-title">Expense Records</h6>
                <p class="table-subtitle">@Model.Count() expenses found</p>
            </div>
            <div class="table-actions">
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-outline-secondary btn-sm active" id="tableViewBtn" data-view="table">
                        <i class="bi bi-list"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="cardViewBtn" data-view="cards">
                        <i class="bi bi-grid-3x3-gap"></i>
                    </button>
                </div>
            </div>
        </div>
        
        <div class="table-responsive" id="tableView">
            <table id="expensesTable" class="table table-hover align-middle mb-0 modern-table">
                <thead>
                    <tr>
                        <th><i class="bi bi-calendar3 me-1"></i>Date</th>
                        <th><i class="bi bi-tag me-1"></i>Category</th>
                        <th class="text-end"><i class="bi bi-currency-rupee me-1"></i>Amount</th>
                        <th><i class="bi bi-card-text me-1"></i>Description</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr class="expense-row">
                            <td>
                                <div class="date-cell">
                                    <span class="date-primary">@e.ExpenseDate.ToString("MMM dd")</span>
                                    <span class="date-secondary">@e.ExpenseDate.ToString("yyyy")</span>
                                </div>
                            </td>
                            <td>
                                <span class="category-badge">
                                    <i class="bi bi-tag-fill me-1"></i>
                                    @(((IDictionary<int, string>)ViewBag.CatLookup)[e.CategoryId])
                                </span>
                            </td>
                            <td class="text-end">
                                <span class="amount-value">@e.Amount.ToString("C2")</span>
                            </td>
                            <td>
                                <div class="description-cell">
                                    @e.Description
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="action-buttons">
                                    <button class="btn btn-sm btn-outline-primary open-expense-modal" data-bs-toggle="modal" data-bs-target="#expenseModal" data-url="@Url.Action("Edit","Expenses", new { id = e.ExpenseId })" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger open-expense-modal" data-bs-toggle="modal" data-bs-target="#expenseModal" data-url="@Url.Action("Delete","Expenses", new { id = e.ExpenseId })" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Desktop Card Grid View (initially hidden) -->
        <div class="d-none" id="cardView">
            <div class="row g-3">
                @foreach (var e in Model)
                {
                    <div class="col-md-3">
                        <div class="expense-card">
                            <div class="expense-card-header">
                                <div class="expense-date">
                                    <span class="date-day">@e.ExpenseDate.ToString("dd")</span>
                                    <span class="date-month">@e.ExpenseDate.ToString("MMM")</span>
                                </div>
                                <div class="expense-amount">@e.Amount.ToString("C2")</div>
                            </div>
                            <div class="expense-card-body">
                                <div class="expense-description">@e.Description</div>
                                <div class="expense-category">
                                    <i class="bi bi-tag-fill me-1"></i>
                                    @(((IDictionary<int, string>)ViewBag.CatLookup)[e.CategoryId])
                                </div>
                            </div>
                            <div class="expense-card-actions">
                                <button class="btn btn-sm btn-outline-primary open-expense-modal" data-bs-toggle="modal" data-bs-target="#expenseModal" data-url="@Url.Action("Edit","Expenses", new { id = e.ExpenseId })">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </button>
                                <button class="btn btn-sm btn-outline-danger open-expense-modal" data-bs-toggle="modal" data-bs-target="#expenseModal" data-url="@Url.Action("Delete","Expenses", new { id = e.ExpenseId })">
                                    <i class="bi bi-trash me-1"></i>Delete
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Tablet Card Grid View -->
<div class="d-none d-md-block d-lg-none">
    <div class="row g-3">
        @foreach (var e in Model)
        {
            <div class="col-md-6">
                <div class="expense-card">
                    <div class="expense-card-header">
                        <div class="expense-date">
                            <span class="date-day">@e.ExpenseDate.ToString("dd")</span>
                            <span class="date-month">@e.ExpenseDate.ToString("MMM")</span>
                        </div>
                        <div class="expense-amount">@e.Amount.ToString("C2")</div>
                    </div>
                    <div class="expense-card-body">
                        <div class="expense-description">@e.Description</div>
                        <div class="expense-category">
                            <i class="bi bi-tag-fill me-1"></i>
                            @(((IDictionary<int, string>)ViewBag.CatLookup)[e.CategoryId])
                        </div>
                    </div>
                    <div class="expense-card-actions">
                        <button class="btn btn-sm btn-outline-primary open-expense-modal" data-bs-toggle="modal" data-bs-target="#expenseModal" data-url="@Url.Action("Edit","Expenses", new { id = e.ExpenseId })">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                        <button class="btn btn-sm btn-outline-danger open-expense-modal" data-bs-toggle="modal" data-bs-target="#expenseModal" data-url="@Url.Action("Delete","Expenses", new { id = e.ExpenseId })">
                            <i class="bi bi-trash me-1"></i>Delete
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Mobile List View -->
<div class="d-md-none">
    <div class="mobile-expense-list">
        @foreach (var e in Model)
        {
            <div class="mobile-expense-item">
                <div class="mobile-expense-main">
                    <div class="mobile-expense-info">
                        <div class="mobile-expense-description">@e.Description</div>
                        <div class="mobile-expense-meta">
                            <span class="mobile-date">
                                <i class="bi bi-calendar3 me-1"></i>
                                @e.ExpenseDate.ToString("MMM dd, yyyy")
                            </span>
                            <span class="mobile-category">
                                <i class="bi bi-tag-fill me-1"></i>
                                @(((IDictionary<int, string>)ViewBag.CatLookup)[e.CategoryId])
                            </span>
                        </div>
                    </div>
                    <div class="mobile-expense-amount">@e.Amount.ToString("C2")</div>
                </div>
                <div class="mobile-expense-actions">
                    <button class="btn btn-sm btn-outline-primary open-expense-modal" data-bs-toggle="modal" data-bs-target="#expenseModal" data-url="@Url.Action("Edit","Expenses", new { id = e.ExpenseId })">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger open-expense-modal" data-bs-toggle="modal" data-bs-target="#expenseModal" data-url="@Url.Action("Delete","Expenses", new { id = e.ExpenseId })">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<nav id="serverPagination" aria-label="Page navigation" class="mt-3">
    <ul class="pagination">
        @for (int p = 1; p <= paged.TotalPages; p++)
        {
            <li class="page-item @(p == paged.Page ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-pageSize="@paged.PageSize" asp-route-search="@filter.Search" asp-route-categoryId="@filter.CategoryId" asp-route-fromDate="@filter.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@filter.ToDate?.ToString("yyyy-MM-dd")">@p</a>
            </li>
        }
    </ul>
</nav>


