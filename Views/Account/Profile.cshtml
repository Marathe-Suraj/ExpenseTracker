@using ExpenseTracker.Controllers
@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<div class="profile-hero mb-4 fade-in">
    <div class="d-flex align-items-center justify-content-between flex-wrap">
        <div class="d-flex align-items-center">
            <div class="me-3">
                <span class="hero-icon d-inline-flex align-items-center justify-content-center">
                    <i class="bi bi-person-circle"></i>
                </span>
            </div>
            <div>
                <div class="hero-subtitle">Account Management</div>
                <h2 class="hero-title mb-0">My Profile</h2>
            </div>
        </div>
    </div>
    <div class="hero-description mt-2">
        Manage your personal information and account preferences.
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="profile-card">
            <div class="profile-avatar">
                <div class="avatar-circle">
                    <i class="bi bi-person-fill"></i>
                </div>
                <button class="btn btn-outline-primary btn-sm mt-3">
                    <i class="bi bi-camera me-1"></i>Change Photo
                </button>
            </div>
            <div class="profile-stats">
                <div class="stat-item">
                    <div class="stat-label">Member Since</div>
                    <div class="stat-value">@Model.JoinDate.ToString("MMMM yyyy")</div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">Account Status</div>
                    <div class="stat-value">
                        <span class="badge bg-success">Active</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-8">
        <div class="profile-form-card">
            <div class="card-header">
                <h5 class="card-title">Personal Information</h5>
                <p class="card-subtitle">Update your personal details and contact information</p>
            </div>
            
            <form method="post" asp-action="Profile" class="profile-form">
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">
                            <i class="bi bi-person me-2"></i>
                            Username
                        </label>
                        <input type="text" class="form-control modern-input" asp-for="Username" readonly />
                        <small class="form-text text-muted">Username cannot be changed</small>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">
                            <i class="bi bi-envelope me-2"></i>
                            Email Address
                        </label>
                        <input type="email" class="form-control modern-input" asp-for="Email" />
                        <span class="text-danger" asp-validation-for="Email"></span>
                    </div>
                    
                    <div class="form-group form-group-full">
                        <label class="form-label">
                            <i class="bi bi-card-text me-2"></i>
                            Full Name
                        </label>
                        <input type="text" class="form-control modern-input" asp-for="FullName" />
                        <span class="text-danger" asp-validation-for="FullName"></span>
                    </div>
                </div>
                
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-modern">
                        <i class="bi bi-check2-circle me-1"></i>
                        Save Changes
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-modern">
                        <i class="bi bi-arrow-clockwise me-1"></i>
                        Reset
                    </button>
                </div>
            </form>
        </div>
        
        <div class="profile-form-card mt-4">
            <div class="card-header">
                <h5 class="card-title">Security</h5>
                <p class="card-subtitle">Manage your account security settings</p>
            </div>
            
            <div class="security-actions">
                <div class="security-item">
                    <div class="security-info">
                        <div class="security-title">Password</div>
                        <div class="security-description">Change your account password</div>
                    </div>
                    <button class="btn btn-outline-primary btn-modern">
                        <i class="bi bi-key me-1"></i>
                        Change Password
                    </button>
                </div>
                
                <div class="security-item">
                    <div class="security-info">
                        <div class="security-title">Two-Factor Authentication</div>
                        <div class="security-description">Add an extra layer of security to your account</div>
                    </div>
                    <button class="btn btn-outline-success btn-modern">
                        <i class="bi bi-shield-check me-1"></i>
                        Enable 2FA
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <style>
        .profile-hero {
            background: linear-gradient(135deg, rgba(13,110,253,.08), rgba(32,201,151,.06));
            border: 1px solid rgba(108,117,125,.12);
            border-radius: 1.25rem;
            padding: 2rem;
            backdrop-filter: blur(10px);
            position: relative;
            overflow: hidden;
        }

        .profile-card,
        .profile-form-card {
            background: var(--bs-body-bg);
            border: 1px solid rgba(108,117,125,.1);
            border-radius: 1.25rem;
            padding: 2rem;
            box-shadow: 0 4px 20px rgba(0,0,0,.06);
            height: fit-content;
        }

        .profile-avatar {
            text-align: center;
            margin-bottom: 2rem;
        }

        .avatar-circle {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            margin: 0 auto 1rem;
            box-shadow: 0 8px 32px rgba(102, 126, 234, 0.3);
        }

        .profile-stats {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .stat-item {
            text-align: center;
            padding: 1rem;
            background: rgba(108,117,125,.03);
            border-radius: 10px;
        }

        .stat-label {
            font-size: 0.875rem;
            color: var(--bs-secondary-color);
            margin-bottom: 0.25rem;
        }

        .stat-value {
            font-weight: 600;
            color: var(--bs-emphasis-color);
        }

        .card-header {
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(108,117,125,.1);
        }

        .card-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--bs-emphasis-color);
            margin-bottom: 0.25rem;
        }

        .card-subtitle {
            color: var(--bs-secondary-color);
            font-size: 0.9rem;
            margin: 0;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .form-group-full {
            grid-column: 1 / -1;
        }

        .form-label {
            font-weight: 600;
            color: var(--bs-emphasis-color);
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            font-size: 0.9rem;
        }

        .form-label i {
            color: var(--bs-secondary-color);
            opacity: 0.7;
        }

        .modern-input {
            border-radius: 10px;
            border: 2px solid rgba(108,117,125,.15);
            padding: 0.75rem 1rem;
            transition: all 0.2s ease;
            background: var(--bs-body-bg);
            font-size: 0.95rem;
        }

        .modern-input:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.15);
            background: var(--bs-body-bg);
        }

        .form-actions {
            display: flex;
            gap: 1rem;
            justify-content: flex-end;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(108,117,125,.1);
        }

        .security-actions {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .security-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem;
            background: rgba(108,117,125,.03);
            border-radius: 12px;
            border: 1px solid rgba(108,117,125,.08);
        }

        .security-title {
            font-weight: 600;
            color: var(--bs-emphasis-color);
            margin-bottom: 0.25rem;
        }

        .security-description {
            color: var(--bs-secondary-color);
            font-size: 0.875rem;
        }

        /* Dark mode */
        [data-bs-theme="dark"] .profile-hero,
        [data-bs-theme="dark"] .profile-card,
        [data-bs-theme="dark"] .profile-form-card {
            background-color: #1a1a1a;
            border-color: rgba(255,255,255,.08);
        }

        [data-bs-theme="dark"] .stat-item,
        [data-bs-theme="dark"] .security-item {
            background: rgba(255,255,255,.04);
            border-color: rgba(255,255,255,.08);
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }
            
            .form-actions {
                flex-direction: column;
            }
            
            .security-item {
                flex-direction: column;
                gap: 1rem;
                text-align: center;
            }
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
