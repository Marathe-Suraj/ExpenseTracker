@model ExpenseTracker.Models.Category
@{
    ViewData["Title"] = "Delete Category";
}
<div class="dashboard-hero mb-3">
    <div class="d-flex align-items-center">
        <span class="icon modal-icon danger d-inline-flex align-items-center justify-content-center me-3">
            <i class="bi bi-trash3"></i>
        </span>
        <div>
            <div class="fw-semibold text-uppercase small text-muted">Delete</div>
            <h5 class="mb-0">Category</h5>
        </div>
    </div>
</div>
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-neo">
            <div class="card-body p-4">
                <h6 class="mb-3 text-muted">Please confirm deletion</h6>
                <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>
                <form method="post">
                    <input type="hidden" asp-for="CategoryId" />
                    <div class="d-flex gap-2">
                        <button class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
                        <a class="btn btn-link" asp-action="Index"><i class="bi bi-x-circle me-1"></i>Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles{
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}


