@model IEnumerable<ExpenseTracker.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="categories-hero mb-4 fade-in">
    <div class="d-flex align-items-center justify-content-between flex-wrap">
        <div class="d-flex align-items-center">
            <div class="me-3">
                <span class="hero-icon d-inline-flex align-items-center justify-content-center">
                    <i class="bi bi-tags-fill"></i>
                </span>
            </div>
            <div>
                <div class="hero-subtitle">Organization</div>
                <h2 class="hero-title mb-0">Categories</h2>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-primary btn-modern" data-bs-toggle="modal" data-bs-target="#categoryModal" data-url="@Url.Action("Create","Categories")">
                <i class="bi bi-plus-lg me-1"></i>
                <span class="d-none d-sm-inline">Add Category</span>
            </button>
        </div>
    </div>
    <div class="hero-description mt-2">
        Organize your expenses with custom categories for better tracking and analysis.
    </div>
</div>
<div id="categoriesList" data-list-url="@Url.Action("List","Categories")">
    @await Html.PartialAsync("_CategoryList", Model)
    </div>

@section Styles{
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/expenses.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/v/bs5/dt-2.1.5/datatables.min.css" />
    <style>
        .categories-hero {
            background: linear-gradient(135deg, rgba(13,110,253,.08), rgba(32,201,151,.06));
            border: 1px solid rgba(108,117,125,.12);
            border-radius: 1.25rem;
            padding: 2rem;
            backdrop-filter: blur(10px);
            position: relative;
            overflow: hidden;
        }

        .categories-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, transparent 30%, rgba(255,255,255,.02) 50%, transparent 70%);
            pointer-events: none;
        }

        /* Dark mode */
        [data-bs-theme="dark"] .categories-hero {
            background: linear-gradient(135deg, rgba(13,110,253,.15), rgba(32,201,151,.10));
            border-color: rgba(255,255,255,.08);
        }
    </style>
}

@section Scripts{
    <script src="https://cdn.datatables.net/v/bs5/dt-2.1.5/datatables.min.js"></script>
    <script src="~/js/tables.js" asp-append-version="true"></script>
    <script src="~/js/categories.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function(){
            window.initializeCategoriesPage && window.initializeCategoriesPage();
        });
    </script>
}

<!-- Modal Host -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body p-0 position-relative" id="categoryModalBody">
                <div class="p-5 text-center text-muted" id="categoryModalLoader" style="display:none;">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <div>Loading...</div>
                </div>
            </div>
        </div>
    </div>
</div>



