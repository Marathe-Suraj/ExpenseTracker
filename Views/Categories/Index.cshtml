@model IEnumerable<ExpenseTracker.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="categories-hero mb-4 fade-in">
    <div class="d-flex align-items-center justify-content-between flex-wrap">
        <div class="d-flex align-items-center">
            <div class="me-3">
                <span class="hero-icon d-inline-flex align-items-center justify-content-center">
                    <i class="bi bi-tags-fill"></i>
                </span>
            </div>
            <div>
                <div class="hero-subtitle">Organization</div>
                <h2 class="hero-title mb-0">Categories</h2>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-primary btn-modern" data-bs-toggle="modal" data-bs-target="#categoryModal" data-url="@Url.Action("Create","Categories")">
                <i class="bi bi-plus-lg me-1"></i>
                <span class="d-none d-sm-inline">Add Category</span>
            </button>
        </div>
    </div>
    <div class="hero-description mt-2">
        Organize your expenses with custom categories for better tracking and analysis.
    </div>
</div>
<div id="categoriesList" data-list-url="@Url.Action("List","Categories")">
    @await Html.PartialAsync("_CategoryList", Model)
    </div>

@section Styles{
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/expenses.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/categories.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/v/bs5/dt-2.1.5/datatables.min.css" />
}

@section Scripts{
    <script src="https://cdn.datatables.net/v/bs5/dt-2.1.5/datatables.min.js"></script>
    <script src="~/js/tables.js" asp-append-version="true"></script>
    <script src="~/js/categories.js" asp-append-version="true"></script>
    <script src="~/js/categories-page.js" asp-append-version="true"></script>
}

<!-- Modal Host -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body p-0 position-relative" id="categoryModalBody">
                <div class="p-5 text-center text-muted d-none" id="categoryModalLoader">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <div>Loading...</div>
                </div>
            </div>
        </div>
    </div>
</div>



