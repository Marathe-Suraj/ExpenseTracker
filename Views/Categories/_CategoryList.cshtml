@model IEnumerable<ExpenseTracker.Models.Category>

<!-- Desktop Table View -->
<div class="d-none d-md-block">
    <div class="categories-table-card">
        <div class="table-header">
            <div class="table-info">
                <h6 class="table-title">Category Management</h6>
                <p class="table-subtitle">@Model.Count() categories found</p>
            </div>
        </div>
        
        <div class="table-responsive">
            <table id="categoriesTable" class="table table-hover align-middle mb-0 modern-table">
                <thead>
                    <tr>
                        <th><i class="bi bi-tag me-1"></i>Category Name</th>
                        <th><i class="bi bi-check-circle me-1"></i>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model)
                {
                    <tr class="category-row">
                        <td>
                            <div class="category-name-cell">
                                <div class="category-icon">
                                    <i class="bi bi-tag-fill"></i>
                                </div>
                                <span class="category-name">@c.Name</span>
                            </div>
                        </td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="status-badge status-active">
                                    <i class="bi bi-check-circle-fill me-1"></i>Active
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">
                                    <i class="bi bi-x-circle-fill me-1"></i>Inactive
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="action-buttons">
                                @if (c.IsActive)
                                {
                                    <button class="btn btn-sm btn-outline-primary open-category-modal" data-bs-toggle="modal" data-bs-target="#categoryModal" data-url="@Url.Action("Edit","Categories", new { id = c.CategoryId })" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled title="Category must be active to edit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                }
                                @if (c.IsActive)
                                {
                                    <button class="btn btn-sm btn-outline-warning toggle-category-status" data-category-id="@c.CategoryId" data-action="deactivate" title="Deactivate">
                                        <i class="bi bi-pause-circle"></i>
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-success toggle-category-status" data-category-id="@c.CategoryId" data-action="activate" title="Activate">
                                        <i class="bi bi-play-circle"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Mobile Card View -->
<div class="d-md-none">
    <div class="mobile-category-list">
        @foreach (var c in Model)
        {
            <div class="mobile-category-item">
                <div class="mobile-category-main">
                    <div class="mobile-category-info">
                        <div class="mobile-category-name">
                            <i class="bi bi-tag-fill me-2"></i>
                            @c.Name
                        </div>
                        <div class="mobile-category-status">
                            @if (c.IsActive)
                            {
                                <span class="status-badge status-active">
                                    <i class="bi bi-check-circle-fill me-1"></i>Active
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">
                                    <i class="bi bi-x-circle-fill me-1"></i>Inactive
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="mobile-category-actions">
                    @if (c.IsActive)
                    {
                        <button class="btn btn-sm btn-outline-primary open-category-modal" data-bs-toggle="modal" data-bs-target="#categoryModal" data-url="@Url.Action("Edit","Categories", new { id = c.CategoryId })">
                            <i class="bi bi-pencil"></i>
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-secondary" disabled title="Category must be active to edit">
                            <i class="bi bi-pencil"></i>
                        </button>
                    }
                    @if (c.IsActive)
                    {
                        <button class="btn btn-sm btn-outline-warning toggle-category-status" data-category-id="@c.CategoryId" data-action="deactivate" title="Deactivate">
                            <i class="bi bi-pause-circle"></i>
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-success toggle-category-status" data-category-id="@c.CategoryId" data-action="activate" title="Activate">
                            <i class="bi bi-play-circle"></i>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>



