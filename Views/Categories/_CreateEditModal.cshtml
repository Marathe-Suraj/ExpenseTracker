@model ExpenseTracker.Models.Category
@{
    var isEdit = Model.CategoryId > 0;
    var formAction = isEdit ? "Edit" : "Create";
}

<div class="category-modal">
    <div class="category-modal-header">
        <div class="modal-icon">
            <i class="bi bi-@(isEdit ? "pencil-square" : "plus-circle")"></i>
        </div>
        <div class="modal-title-section">
            <h4 class="modal-title">@(isEdit ? "Edit Category" : "Add New Category")</h4>
            <p class="modal-subtitle">@(isEdit ? "Update category information" : "Create a new expense category for better organization")</p>
        </div>
        <button type="button" class="btn-close-modern" data-bs-dismiss="modal" aria-label="Close">
            <i class="bi bi-x"></i>
        </button>
    </div>
    
    <div class="category-modal-body">
        <form method="post" asp-action="@formAction" id="categoryForm" class="category-form">
            @if (isEdit)
            {
                <input type="hidden" asp-for="CategoryId" />
            }
            
            <div class="form-group">
                <label class="form-label">
                    <i class="bi bi-tag me-2"></i>
                    Category Name
                </label>
                <input type="text" class="form-control modern-input" asp-for="Name" placeholder="Enter category name (e.g., Food, Transport, Entertainment)" />
                <span class="text-danger validation-message" asp-validation-for="Name"></span>
                <small class="form-text text-muted">Choose a descriptive name that helps you organize your expenses</small>
            </div>
            
            <div class="category-modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-modern" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary btn-modern">
                    <i class="bi bi-@(isEdit ? "check2-circle" : "plus-circle") me-1"></i>
                    @(isEdit ? "Update Category" : "Create Category")
                </button>
            </div>
        </form>
    </div>
    
    <partial name="_ValidationScriptsPartial" />
</div>



