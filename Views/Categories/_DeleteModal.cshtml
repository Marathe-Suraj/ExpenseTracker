@model ExpenseTracker.Models.Category

<div class="delete-modal">
    <div class="delete-modal-header">
        <div class="modal-icon danger-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <div class="modal-title-section">
            <h4 class="modal-title">Delete Category</h4>
            <p class="modal-subtitle">This action cannot be undone</p>
        </div>
        <button type="button" class="btn-close-modern" data-bs-dismiss="modal" aria-label="Close">
            <i class="bi bi-x"></i>
        </button>
    </div>
    
    <div class="delete-modal-body">
        <div class="warning-message">
            <i class="bi bi-info-circle me-2"></i>
            Are you sure you want to delete this category? This action cannot be undone and may affect existing expenses.
        </div>
        
        <div class="category-details">
            <div class="detail-item">
                <div class="detail-label">
                    <i class="bi bi-tag me-2"></i>Category Name
                </div>
                <div class="detail-value">@Model.Name</div>
            </div>
            
            <div class="detail-item">
                <div class="detail-label">
                    <i class="bi bi-check-circle me-2"></i>Status
                </div>
                <div class="detail-value">
                    @if (Model.IsActive)
                    {
                        <span class="status-badge status-active">
                            <i class="bi bi-check-circle-fill me-1"></i>Active
                        </span>
                    }
                    else
                    {
                        <span class="status-badge status-inactive">
                            <i class="bi bi-x-circle-fill me-1"></i>Inactive
                        </span>
                    }
                </div>
            </div>
        </div>
        
        <form method="post" asp-action="Delete" asp-route-id="@Model.CategoryId" id="categoryDeleteForm">
            <input type="hidden" asp-for="CategoryId" />
            <div class="delete-modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-modern" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>
                    Cancel
                </button>
                <button type="submit" class="btn btn-danger btn-modern">
                    <i class="bi bi-trash me-1"></i>
                    Delete Category
                </button>
            </div>
        </form>
    </div>
</div>



