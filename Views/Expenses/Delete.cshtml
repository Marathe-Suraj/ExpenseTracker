@model ExpenseTracker.Models.Expense
@{
    ViewData["Title"] = "Delete Expense";
}
<div class="dashboard-hero mb-3">
    <div class="d-flex align-items-center">
        <span class="icon d-inline-flex align-items-center justify-content-center me-3" style="width:48px;height:48px;border-radius:12px;background:rgba(220,53,69,.12);color:#dc3545;">
            <i class="bi bi-trash3"></i>
        </span>
        <div>
            <div class="fw-semibold text-uppercase small text-muted">Delete</div>
            <h5 class="mb-0">Expense</h5>
        </div>
    </div>
</div>
<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card card-neo">
            <div class="card-body p-4">
                <h6 class="mb-3 text-muted">Please confirm deletion</h6>
                <p>Are you sure you want to delete this expense?</p>
                <dl class="row">
                    <dt class="col-sm-3">Date</dt>
                    <dd class="col-sm-9">@Model.ExpenseDate.ToString("yyyy-MM-dd")</dd>
                    <dt class="col-sm-3">Amount</dt>
                    <dd class="col-sm-9">@Model.Amount.ToString("C2")</dd>
                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@Model.Description</dd>
                </dl>
                <form method="post" class="mt-2 d-flex gap-2">
                    <input type="hidden" asp-for="ExpenseId" />
                    <button class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
                    <a class="btn btn-link" asp-action="Index"><i class="bi bi-x-circle me-1"></i>Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>


@section Styles{
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}


