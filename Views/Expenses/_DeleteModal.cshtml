@model ExpenseTracker.Models.Expense

<div class="delete-modal">
    <div class="delete-modal-header">
        <div class="modal-icon danger-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <div class="modal-title-section">
            <h4 class="modal-title">Delete Expense</h4>
            <p class="modal-subtitle">This action cannot be undone</p>
        </div>
        <button type="button" class="btn-close-modern" data-bs-dismiss="modal" aria-label="Close">
            <i class="bi bi-x"></i>
        </button>
    </div>
    
    <div class="delete-modal-body">
        <div class="warning-message">
            <i class="bi bi-info-circle me-2"></i>
            Are you sure you want to delete this expense? This action cannot be undone.
        </div>
        
        <div class="expense-details">
            <div class="detail-item">
                <div class="detail-label">
                    <i class="bi bi-calendar-event me-2"></i>Date
                </div>
                <div class="detail-value">@Model.ExpenseDate.ToString("MMM dd, yyyy")</div>
            </div>
            
            <div class="detail-item">
                <div class="detail-label">
                    <i class="bi bi-currency-rupee me-2"></i>Amount
                </div>
                <div class="detail-value amount-highlight">@Model.Amount.ToString("C2")</div>
            </div>
            
            <div class="detail-item">
                <div class="detail-label">
                    <i class="bi bi-card-text me-2"></i>Description
                </div>
                <div class="detail-value">@(string.IsNullOrEmpty(Model.Description) ? "No description" : Model.Description)</div>
            </div>
        </div>
        
        <form method="post" asp-action="Delete" asp-route-id="@Model.ExpenseId" id="expenseDeleteForm">
            <input type="hidden" asp-for="ExpenseId" />
            <div class="delete-modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-modern" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>
                    Cancel
                </button>
                <button type="submit" class="btn btn-danger btn-modern">
                    <i class="bi bi-trash me-1"></i>
                    Delete Expense
                </button>
            </div>
        </form>
    </div>
</div>



