@model IEnumerable<ExpenseTracker.Models.RecurringExpense>
@{
    ViewData["Title"] = "Recurring";
    var categories = (IEnumerable<ExpenseTracker.Models.Category>)ViewBag.Categories;
}
<div class="dashboard-hero mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="hero-subtitle">Automation</div>
        <h2 class="hero-title">Recurring Expenses</h2>
        <div class="hero-description">Scheduled expenses are created automatically when you open Dashboard or Expenses.</div>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#recurringModal" id="btnAddRecurring">Add Recurring</button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">No recurring expenses configured.</div>
}
else
{
    <div class="row g-3">
        @foreach (var r in Model)
        {
            <div class="col-md-6">
                <div class="card card-body">
                    <div class="d-flex justify-content-between">
                        <strong>@r.CategoryName</strong>
                        <span class="badge bg-primary">@r.Frequency</span>
                    </div>
                    <div class="fs-4 my-2">@r.Amount.ToString("C2")</div>
                    <div>@r.Description</div>
                    <div class="small text-muted mt-2">Next: @r.NextRunDate.ToString("dd/MM/yyyy")</div>
                    <div class="mt-3">
                        <button type="button" class="btn btn-sm btn-outline-primary btn-edit-recurring"
                                data-id="@r.RecurringExpenseId"
                                data-category-id="@r.CategoryId"
                                data-amount="@r.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                data-frequency="@r.Frequency"
                                data-start="@r.StartDate.ToString("yyyy-MM-dd")"
                                data-next="@r.NextRunDate.ToString("yyyy-MM-dd")"
                                data-end="@(r.EndDate?.ToString("yyyy-MM-dd") ?? "")"
                                data-description="@r.Description">Edit</button>
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this recurring expense?');">
                            <input type="hidden" name="id" value="@r.RecurringExpenseId">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="modal fade" id="recurringModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Save" method="post" id="recurringForm">
                <div class="modal-header">
                    <h5 class="modal-title">Recurring Expense</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="RecurringExpenseId" id="RecurringExpenseId" value="0">
                    <label class="form-label" for="RecurringCategoryId">Category</label>
                    <select required class="form-select mb-2" name="CategoryId" id="RecurringCategoryId">
                        <option value="">Select</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.CategoryId">@c.Name</option>
                        }
                    </select>
                    <label class="form-label" for="RecurringAmount">Amount</label>
                    <input required min="0.01" step="0.01" type="number" class="form-control mb-2" name="Amount" id="RecurringAmount">
                    <label class="form-label" for="Frequency">Frequency</label>
                    <select class="form-select mb-2" name="Frequency" id="Frequency">
                        <option value="Monthly">Monthly</option>
                        <option value="Weekly">Weekly</option>
                        <option value="Yearly">Yearly</option>
                    </select>
                    <div class="row">
                        <div class="col">
                            <label class="form-label" for="StartDate">Start</label>
                            <input required type="date" class="form-control" name="StartDate" id="StartDate">
                        </div>
                        <div class="col">
                            <label class="form-label" for="NextRunDate">Next run</label>
                            <input required type="date" class="form-control" name="NextRunDate" id="NextRunDate">
                        </div>
                    </div>
                    <label class="form-label mt-2" for="EndDate">End (optional)</label>
                    <input type="date" class="form-control mb-2" name="EndDate" id="EndDate">
                    <label class="form-label" for="RecurringDescription">Description</label>
                    <textarea maxlength="500" class="form-control" name="Description" id="RecurringDescription"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    function newRecurring() {
        document.getElementById('recurringForm').reset();
        document.getElementById('RecurringExpenseId').value = '0';
        var d = new Date().toISOString().slice(0, 10);
        document.getElementById('StartDate').value = d;
        document.getElementById('NextRunDate').value = d;
    }
    document.getElementById('btnAddRecurring')?.addEventListener('click', newRecurring);
    document.querySelectorAll('.btn-edit-recurring').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('RecurringExpenseId').value = btn.dataset.id;
            document.getElementById('RecurringCategoryId').value = btn.dataset.categoryId;
            document.getElementById('RecurringAmount').value = btn.dataset.amount;
            document.getElementById('Frequency').value = btn.dataset.frequency;
            document.getElementById('StartDate').value = btn.dataset.start;
            document.getElementById('NextRunDate').value = btn.dataset.next;
            document.getElementById('EndDate').value = btn.dataset.end || '';
            document.getElementById('RecurringDescription').value = btn.dataset.description || '';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('recurringModal')).show();
        });
    });
})();
</script>
}
