@model ExpenseTracker.ViewModels.ReportsViewModel
@{ ViewData["Title"]="Reports"; }
<div class="dashboard-hero mb-4"><div class="hero-subtitle">Analysis</div><h2 class="hero-title">Reports</h2><div class="hero-description">Review expenses, income and net cash flow for any date range.</div></div>
<form method="get" class="card card-body mb-4"><div class="row g-2 align-items-end"><div class="col-md-4"><label class="form-label">From</label><input required type="date" class="form-control" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")"></div><div class="col-md-4"><label class="form-label">To</label><input required type="date" class="form-control" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")"></div><div class="col"><button class="btn btn-primary">Run Report</button></div></div></form>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card card-body"><span class="text-muted">Income</span><strong class="fs-3 text-success">@Model.TotalIncome.ToString("C2")</strong></div></div><div class="col-md-4"><div class="card card-body"><span class="text-muted">Expenses</span><strong class="fs-3 text-danger">@Model.TotalExpense.ToString("C2")</strong></div></div><div class="col-md-4"><div class="card card-body"><span class="text-muted">Net</span><strong class="fs-3">@Model.Net.ToString("C2")</strong></div></div></div>
<div class="row g-4"><div class="col-lg-6"><div class="card"><div class="card-header"><strong>Expenses by category</strong></div><ul class="list-group list-group-flush">@foreach(var c in Model.CategoryTotals.OrderByDescending(x=>x.TotalAmount)){<li class="list-group-item d-flex justify-content-between"><span>@c.CategoryName</span><strong>@c.TotalAmount.ToString("C2")</strong></li>}</ul></div></div><div class="col-lg-6"><div class="card"><div class="card-header"><strong>Daily expenses</strong></div><ul class="list-group list-group-flush">@foreach(var d in Model.DailyTotals){<li class="list-group-item d-flex justify-content-between"><span>@d.DateLabel</span><strong>@d.TotalAmount.ToString("C2")</strong></li>}</ul></div></div></div>
<div class="mt-4"><a class="btn btn-outline-success" asp-controller="Expenses" asp-action="ExportExcel" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")">Export Expenses Excel</a> <a class="btn btn-outline-danger" asp-controller="Expenses" asp-action="ExportPdf" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")">Export Expenses PDF</a></div>
